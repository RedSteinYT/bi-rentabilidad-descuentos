                  "partitions": [
                    {
                      "name": "Partition",
                      "dataView": "full",
                      "source": {
                        "type": "m",
                        "expression": [
                          "let",
                          "    Source = #\"SQL/localhost;DataMart_Rentabilidad\",",
                          "    dbo_Fact_Ventas = Source{[Schema=\"dbo\",Item=\"Fact_Ventas\"]}[Data]",
                          "in",
                          "    dbo_Fact_Ventas"
                        ]
                      }
                    }
                  ],
                  "measures": [
                    {
                      "name": "Ventas Totales",
                      "expression": " SUM(Fact_Ventas[Ventas])",
                      "formatString": "\"$\" #,0.00;-\"$\" #,0.00;\"$\" #,0.00"
                    },
                    {
                      "name": "Ganancia Total",
                      "expression": " SUM(Fact_Ventas[Ganancia])",
                      "formatString": "\"$\" #,0.00;-\"$\" #,0.00;\"$\" #,0.00"
                    },
                    {
                      "name": "Margen %",
                      "expression": " DIVIDE([Ganancia Total], [Ventas Totales])",
                      "formatString": "0.00 %;-0.00 %;0.00 %"
                    },
                    {
                      "name": "Cantidad Vendida",
                      "expression": " SUM(Fact_Ventas[Cantidad])",
                      "formatString": "0"
                    },
                    {
                      "name": "Costo Envío Total",
                      "expression": " SUM(Fact_Ventas[CostoEnvio])",
                      "formatString": "\"$\" #,0.00;-\"$\" #,0.00;\"$\" #,0.00"
                    },
                    {
                      "name": "Descuento Promedio",
                      "expression": " AVERAGE(Fact_Ventas[Descuento])",
                      "formatString": "0.00 %;-0.00 %;0.00 %"
                    },
                    {
                      "name": "Líneas de Venta",
                      "expression": " COUNTROWS(Fact_Ventas)",
                      "formatString": "0"
                    },
                    {
                      "name": "Pedidos",
                      "expression": " DISTINCTCOUNT(Fact_Ventas[CodigoPedido])",
                      "formatString": "0"
                    },
                    {
                      "name": "Ticket Promedio",
                      "expression": " DIVIDE([Ventas Totales], [Pedidos])",
                      "formatString": "\"$\" #,0.00;-\"$\" #,0.00;\"$\" #,0.00"
                    },
                    {
                      "name": "Líneas con Pérdida",
                      "expression": " CALCULATE(COUNTROWS(Fact_Ventas), Fact_Ventas[Ganancia] < 0)",
                      "formatString": "0"
                    },
                    {
                      "name": "% Líneas con Pérdida",
                      "expression": " DIVIDE([Líneas con Pérdida], [Líneas de Venta])",
                      "formatString": "0.00 %;-0.00 %;0.00 %"
                    },
                    {
                      "name": "Pérdida Total",
                      "expression": " CALCULATE([Ganancia Total], Fact_Ventas[Ganancia] < 0)",
                      "formatString": "\"$\" #,0.00;-\"$\" #,0.00;\"$\" #,0.00"
                    },
                    {
                      "name": "Ganancia con Descuento Alto",
                      "expression": " CALCULATE([Ganancia Total], Fact_Ventas[Descuento] > 0.2)",
                      "formatString": "\"$\" #,0.00;-\"$\" #,0.00;\"$\" #,0.00"
                    },
                    {
                      "name": "Ventas Año Anterior",
                      "expression": " CALCULATE([Ventas Totales], SAMEPERIODLASTYEAR(Dim_Tiempo[Fecha]))",
                      "formatString": "\"$\" #,0.00;-\"$\" #,0.00;\"$\" #,0.00"
                    },
                    {
                      "name": "Crecimiento YoY",
                      "expression": " DIVIDE([Ventas Totales] - [Ventas Año Anterior], [Ventas Año Anterior])",
                      "formatString": "0.00 %;-0.00 %;0.00 %"
                    },
                    {
                      "name": "Tope Seleccionado",
                      "expression": " SELECTEDVALUE('Tope Descuento'[Tope], 1)",
                      "formatString": "0.00 %;-0.00 %;0.00 %"
                    },
                    {
                      "name": "Ventas Simuladas",
                      "expression": " SUMX(Fact_Ventas, DIVIDE(Fact_Ventas[Ventas], 1 - Fact_Ventas[Descuento]) * (1 - MIN(Fact_Ventas[Descuento], [Tope Seleccionado])))",
                      "formatString": "\"$\" #,0.00;-\"$\" #,0.00;\"$\" #,0.00"
                    },
                    {
                      "name": "Ganancia Simulada",
                      "expression": " [Ventas Simuladas] - SUMX(Fact_Ventas, Fact_Ventas[Ventas] - Fact_Ventas[Ganancia])",
                      "formatString": "\"$\" #,0.00;-\"$\" #,0.00;\"$\" #,0.00"
                    },
                    {
                      "name": "Margen Simulado",
                      "expression": " DIVIDE([Ganancia Simulada], [Ventas Simuladas])",
                      "formatString": "0.00 %;-0.00 %;0.00 %"
                    },
                    {
                      "name": "Ganancia Recuperada",
                      "expression": " [Ganancia Simulada] - [Ganancia Total]",
                      "formatString": "\"$\" #,0.00;-\"$\" #,0.00;\"$\" #,0.00"
                    }
                  ]
                },
