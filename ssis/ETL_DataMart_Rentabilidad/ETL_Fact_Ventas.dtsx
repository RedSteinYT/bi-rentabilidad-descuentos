              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    CONVERT(INT, CONVERT(CHAR(8), p.fecha_pedido, 112)) AS TiempoKey,
    dp.ProductoKey,
    dc.ClienteKey,
    dg.GeografiaKey,
    de.EnvioKey,
    CASE WHEN d.descuento = 0    THEN 1
         WHEN d.descuento &lt;= 0.20 THEN 2
         WHEN d.descuento &lt;= 0.40 THEN 3
         WHEN d.descuento &lt;= 0.60 THEN 4
         ELSE 5 END AS BandaKey,
    d.id_detalle   AS DetallePedidoID,
    p.codigo_pedido AS CodigoPedido,
    d.ventas       AS Ventas,
    d.cantidad     AS Cantidad,
    d.descuento    AS Descuento,
    d.ganancia     AS Ganancia,
    d.costo_envio  AS CostoEnvio
FROM DET_PEDIDO AS d
INNER JOIN CAB_PEDIDO AS p
    ON d.id_pedido = p.id_pedido                 -- por la PK, no por codigo_pedido
INNER JOIN DataMart_Rentabilidad.dbo.Dim_Producto  AS dp ON d.id_producto  = dp.ProductoID
INNER JOIN DataMart_Rentabilidad.dbo.Dim_Cliente   AS dc ON p.id_cliente   = dc.ClienteID
INNER JOIN DataMart_Rentabilidad.dbo.Dim_Geografia AS dg ON p.id_ubicacion = dg.UbicacionID
INNER JOIN DataMart_Rentabilidad.dbo.Dim_Envio     AS de ON p.id_modo_envio = de.ModoEnvioID
                                                       AND p.id_prioridad  = de.PrioridadID
INNER JOIN DataMart_Rentabilidad.dbo.Dim_Tiempo    AS dt ON p.fecha_pedido = dt.Fecha;</property>
                <property
